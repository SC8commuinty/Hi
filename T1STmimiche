local function getChar()
	local char = player.Character
	if not char then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hrp and hum and hum.Health > 0 then
		return char, hrp, hum
	end
	return nil
end

local function safe(fn: () -> ())
	local ok, err = pcall(fn)
	if not ok then
		busy = false
		setStatus("Error: " .. tostring(err))
	end
end

local function isCarrying(): boolean
	local v = player:GetAttribute("Stealing")
	return v ~= nil and v ~= false
end

saveBtn.Activated:Connect(function()
	safe(function()
		local _, hrp = getChar()
		if not hrp then return setStatus("No character.") end
		savedCFrame = hrp.CFrame
		setStatus("Saved. Position and facing stored.")
	end)
end)

tpBtn.Activated:Connect(function()
	if busy then return end
	safe(function()
		if not savedCFrame then return setStatus("Save a spot first.") end
		local char, hrp, hum = getChar()
		if not char then return setStatus("No character.") end

		busy = true
		char:PivotTo(savedCFrame)
		hrp.AssemblyLinearVelocity = Vector3.zero
		task.wait(EQUIP_DELAY)

		local tool = player.Backpack:FindFirstChild(TOOL_NAME) or char:FindFirstChild(TOOL_NAME)
		if not tool or not tool:IsA("Tool") then
			setStatus("Tool not found: " .. TOOL_NAME)
			busy = false
			return
		end

		if tool.Parent ~= char then
			hum:EquipTool(tool)
			task.wait(EQUIP_DELAY)
		end

		char:PivotTo(savedCFrame)
		task.wait(ACTIVATE_DELAY)
		tool:Activate()

		setStatus("Done.")
		busy = false
	end)
end)

