local prompts: { [ProximityPrompt]: boolean } = {}

local function register(inst: Instance)
	if inst:IsA("ProximityPrompt") then
		prompts[inst] = true
	end
end

track(Workspace.DescendantAdded:Connect(register))
track(Workspace.DescendantRemoving:Connect(function(inst)
	if inst:IsA("ProximityPrompt") then
		prompts[inst] = nil
	end
end))

task.spawn(function()
	local n = 0
	for _, inst in ipairs(Workspace:GetDescendants()) do
		register(inst)
		n += 1
		if n % 1500 == 0 then task.wait() end
	end
end)

local function promptPos(prompt: ProximityPrompt): Vector3?
	local parent = prompt.Parent
	if not parent then return nil end
	if parent:IsA("Attachment") then
		return parent.WorldPosition
	elseif parent:IsA("BasePart") then
		return parent.Position
	elseif parent:IsA("Model") then
		return parent:GetPivot().Position
	end
	local part = parent:FindFirstAncestorWhichIsA("BasePart")
	return part and part.Position or nil
end

local function isStealPrompt(prompt: ProximityPrompt): boolean
	return string.find(string.lower(prompt.ActionText), STEAL_WORD, 1, true) ~= nil
end

local handlerCache = setmetatable({}, { __mode = "k" })

local function getHandlers(prompt: ProximityPrompt)
	local cached = handlerCache[prompt]
	if cached and #cached.trigger > 0 then
		return cached
	end
	local h = { hold = {}, trigger = {} }
	if typeof(getconnections) == "function" then
		pcall(function()
			for _, c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
				local f = c.Function
				if type(f) == "function" then
					local src = ""
					pcall(function() src = debug.info(f, "s") or "" end)
					if not (src:find("PlotClient", 1, true) and not src:find("AnimalPrompt", 1, true)) then
						h.hold[#h.hold + 1] = f
					end
				end
			end
			for _, c in ipairs(getconnections(prompt.Triggered)) do
				if type(c.Function) == "function" then
					h.trigger[#h.trigger + 1] = c.Function
				end
			end
		end)
	end
	handlerCache[prompt] = h
	return h
end

local function plainHold(prompt: ProximityPrompt)
	if holdBusy or not prompt.Parent then return end
	holdBusy = true
	pcall(function() prompt.RequiresLineOfSight = false end)
	pcall(function() prompt:InputHoldBegin() end)
	local need = math.max(prompt.HoldDuration, HOLD_TIME) + 0.05
	local t0 = os.clock()
	while os.clock() - t0 < need do
		local _, hrp = getChar()
		local pos = prompt.Parent and promptPos(prompt)
		if not hrp or not pos or (pos - hrp.Position).Magnitude > range + 15 or isCarrying() then
			break
		end
		task.wait()
	end
	pcall(function() prompt:InputHoldEnd() end)
	holdBusy = false
end

local stealList: { ProximityPrompt } = {}
local listAt = 0
local bankAt = 0
local bankPrompt: ProximityPrompt? = nil
local lastFire = 0
local lastFallback = 0
local wasCarrying = false

local function refreshList()
	table.clear(stealList)
	for p in pairs(prompts) do
		if p.Parent and isStealPrompt(p) then
			stealList[#stealList + 1] = p
		end
	end
end

local function stealTick()
	local carrying = isCarrying()
	if carrying ~= wasCarrying then
		wasCarrying = carrying
		bankPrompt = nil
		setStatus(carrying and "Stolen." or "Ready.")
	end

	if not autoSteal or carrying or holdBusy then
		if not autoSteal then bankPrompt = nil end
		return
	end

	local _, hrp = getChar()
	if not hrp then return end

	local now = os.clock()
	if now - listAt > 1 then
		listAt = now
		refreshList()
	end

	local target: ProximityPrompt? = nil
	local targetDist = math.huge
	local arm: ProximityPrompt? = nil
	local armDist = range + ARM_EXTRA

	for _, p in ipairs(stealList) do
		if p.Parent and p.Enabled then
			local pos = promptPos(p)
			if pos then
				local d = (pos - hrp.Position).Magnitude
				if d <= armDist then
					arm, armDist = p, d
				end
				if d <= range and d < targetDist then
					target, targetDist = p, d
				end
			end
		end
	end

	if not arm then
		bankPrompt = nil
		return
	end

	local h = getHandlers(arm)
	if #h.hold == 0 or #h.trigger == 0 then
		if target and now - lastFallback > 0.2 then
			lastFallback = now
			task.spawn(plainHold, target)
		end
		return
	end

	local age = bankPrompt and (now - bankAt) or math.huge
	local eta = 0
	if not target then
		local pos = promptPos(arm)
		local dir = pos and (pos - hrp.Position) or Vector3.zero
		local toward = dir.Magnitude > 0 and hrp.AssemblyLinearVelocity:Dot(dir.Unit) or 0
		eta = math.max(armDist - range, 0) / math.max(toward, 8)
	end

	if bankPrompt == nil or age + eta > MAX_AGE then
		pcall(function() arm.RequiresLineOfSight = false end)
		for _, f in ipairs(h.hold) do
			task.spawn(pcall, f, player)
		end
		bankAt, bankPrompt = now, arm
		age = 0
	end

	local need = math.max(arm.HoldDuration, HOLD_TIME) + 0.03
	if not target then
		setStatus(string.format("Approaching. Hold banked (%d studs).", armDist))
		return
	end

	if age >= need and age <= MAX_AGE + 0.3 and now - lastFire >= 0.1 then
		lastFire = now
		local th = getHandlers(target)
		for _, f in ipairs(th.trigger) do
			task.spawn(pcall, f, player)
		end
		local name = target.ObjectText ~= "" and target.ObjectText or "brainrot"
		setStatus("Grabbing " .. name)
	end
end

track(RunService.Heartbeat:Connect(function()
	pcall(stealTick)
end))

